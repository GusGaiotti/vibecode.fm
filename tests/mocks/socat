#!/usr/bin/env bash
# Fake socat: answers mpv IPC commands against the marker files the fake mpv
# creates. Connection "fails" (exit 1) unless the socket has an .alive marker.

set -u

json="$(cat)"

sock=""
for arg in "$@"; do
  case "$arg" in
    UNIX-CONNECT:*) sock="${arg#UNIX-CONNECT:}" ;;
  esac
done

printf '%s\n' "$json" >> "${VIBECODE_TEST_LOG:-/tmp}/ipc.log"

{ [ -n "$sock" ] && [ -e "$sock" ] && [ -e "$sock.alive" ]; } || exit 1

state_file="$sock.state"
case "$json" in
  *'"get_property","mpv-version"'*)
    printf '{"data":"mpv 0.38.0-fake","error":"success"}\n' ;;
  *'"get_property","pause"'*)
    printf '{"data":%s,"error":"success"}\n' "$(cat "$state_file" 2>/dev/null || echo true)" ;;
  *'"get_property","media-title"'*)
    printf '{"data":"Fake FM - Test Track","error":"success"}\n' ;;
  *'"set_property","pause",false'*)
    printf 'false\n' > "$state_file"
    printf '{"error":"success"}\n' ;;
  *'"set_property","pause",true'*)
    printf 'true\n' > "$state_file"
    printf '{"error":"success"}\n' ;;
  *'"quit"'*)
    rm -f "$sock.alive"
    printf '{"error":"success"}\n' ;;
  *)
    printf '{"error":"invalid command"}\n' ;;
esac
