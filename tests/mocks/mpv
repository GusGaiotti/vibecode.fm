#!/usr/bin/env bash
# Fake mpv: records how it was launched and simulates the IPC socket by
# dropping marker files the fake socat understands.

set -u

log_dir="${VIBECODE_TEST_LOG:-/tmp}"
printf '%s\n' "$*" >> "$log_dir/mpv.launches"

sock=""
paused=false
for arg in "$@"; do
  case "$arg" in
    --input-ipc-server=*) sock="${arg#--input-ipc-server=}" ;;
    --pause) paused=true ;;
  esac
done

[ -n "$sock" ] || exit 0
touch "$sock"
printf '%s\n' "$paused" > "$sock.state"
touch "$sock.alive"
exit 0
